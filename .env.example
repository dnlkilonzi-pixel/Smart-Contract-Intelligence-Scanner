# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_me_in_production

# Database
DATABASE_URL=postgresql+asyncpg://scanner:scanner@localhost:5432/smart_contract_scanner

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Blockchain RPC endpoints
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETH_TESTNET_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Block explorer API keys (used for contract/wallet intelligence)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# Static analysis timeouts (seconds)
SLITHER_TIMEOUT=120
MYTHRIL_TIMEOUT=300

# AI model path (relative to project root)
AI_MODEL_PATH=models/vuln_classifier.joblib
