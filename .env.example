# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_me_in_production

# Database
DATABASE_URL=postgresql+asyncpg://scanner:scanner@localhost:5432/smart_contract_scanner

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Blockchain RPC endpoints ─────────────────────────────────────────────────

# Ethereum (mainnet)
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETH_TESTNET_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# BNB Smart Chain
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Polygon
POLYGON_RPC_URL=https://polygon-rpc.com/

# Arbitrum
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ── Block explorer API keys ───────────────────────────────────────────────────
# Used for contract source fetch, ABI lookup, and wallet intelligence.

ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
BSCSCAN_API_KEY=YOUR_BSCSCAN_KEY
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_KEY
ARBISCAN_API_KEY=YOUR_ARBISCAN_KEY

# ── Real-time mempool listener (WebSocket RPC) ────────────────────────────────
# Set ETH_WS_URL to enable live contract deployment scanning.
ETH_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_INFURA_KEY
MEMPOOL_AUTO_SCAN=false

# ── Static analysis timeouts (seconds) ───────────────────────────────────────
SLITHER_TIMEOUT=120
MYTHRIL_TIMEOUT=300

# ── AI model path (relative to project root) ─────────────────────────────────
AI_MODEL_PATH=models/vuln_classifier.joblib

# ── LLM vulnerability explanations ───────────────────────────────────────────
# Set LLM_EXPLANATION_ENABLED=true and provide an OpenAI API key to enable
# AI-generated explanations for each vulnerability finding.
LLM_EXPLANATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

